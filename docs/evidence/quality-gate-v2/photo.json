            "id": "add_row",
            "children": [
              {
                "type": "text_field",
                "id": "add_field",
                "state_ref": "new_item_text",
                "placeholder": "追加する"
              },
              {
                "type": "button",
                "id": "add_button",
                "label": "追加",
                "action": {
                  "type": "add_item",
                  "target_state_ref": "items",
                  "source_state_ref": "new_item_text"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "app": {
    "title": "旅行の写真を日付ごとに残してメモを付けたい"
  },
  "design_tokens": {
    "color_scheme": {
      "primary": "#D68C45",
      "secondary": "#E8B37A",
      "success": "#7A9D6F",
      "error": "#C1666B"
    },
    "corner_radius": {
      "small": 10,
      "medium": 16,
      "large": 24
    },
    "spacing_scale": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32
