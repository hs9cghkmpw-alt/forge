{
  "version": "1.12",
  "initial_screen_id": "generated_screen",
  "screens": [
    {
      "id": "generated_screen",
      "title": "写真記録",
      "state": {
        "records": {
          "type": "record_list",
          "value": [],
          "schema_ref": "record"
        },
        "field_photo": {
          "type": "string",
          "value": ""
        },
        "field_date": {
          "type": "string",
          "value": ""
        },
        "field_note": {
          "type": "string",
          "value": ""
        },
        "selected": {
          "type": "selected_record",
          "value": null
        },
        "edit_field_photo": {
          "type": "string",
          "value": ""
        },
        "edit_field_date": {
          "type": "string",
          "value": ""
        },
        "edit_field_note": {
          "type": "string",
          "value": ""
        }
      },
      "body": {
        "type": "tab_view",
        "id": "root_tabs",
        "tab_titles": [
          "写真記録を追加",
          "写真記録一覧",
          "写真記録を編集"
        ],
        "style_role": "density.normal",
        "children": [
          {
            "type": "column",
            "id": "create_tab",
            "children": [
              {
                "type": "section_header",
                "id": "create_section_header",
                "style_role": "text.headline",
                "title": "写真記録を追加",
                "subtitle": "必要な情報を入力してください"
              },
              {
                "type": "form",
                "id": "record_form",
                "style_role": "button.primary",
                "submit_label": "保存",
                "submit_action": {
                  "type": "composite",
                  "actions": [
                    {
                      "type": "add_record",
                      "target_state_ref": "records",
                      "field_bindings": {
                        "photo": "field_photo",
                        "date": "field_date",
                        "note": "field_note"
                      }
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "field_photo"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "field_date"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "field_note"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "text_field",
                    "id": "field_photo_input",
                    "state_ref": "field_photo",
                    "placeholder": "写真",
                    "validation": {
                      "rules": [
                        {
                          "type": "required",
                          "message": "写真を入力してください"
                        }
                      ]
                    }
                  },
                  {
                    "type": "date_field",
                    "id": "field_date_input",
                    "state_ref": "field_date",
                    "label": "日付"
                  },
                  {
                    "type": "text_field",
                    "id": "field_note_input",
                    "state_ref": "field_note",
                    "placeholder": "メモ"
                  }
                ]
              }
            ]
          },
          {
            "type": "column",
            "id": "list_tab",
            "children": [
              {
                "type": "record_list_view",
                "id": "records_list_view",
                "state_ref": "records",
                "layout": "card",
                "display_fields": [
                  "photo",
                  "date",
                  "note"
                ],
                "empty_state_text": "まだ写真記録がありません",
                "selectable": true,
                "selected_state_ref": "selected",
                "select_field_bindings": {
                  "photo": "edit_field_photo",
                  "date": "edit_field_date",
                  "note": "edit_field_note"
                },
                "style_role": "surface.card"
              }
            ]
          },
          {
            "type": "column",
            "id": "edit_tab",
            "children": [
              {
                "type": "section_header",
                "id": "edit_section_header",
                "style_role": "text.headline",
                "title": "写真記録を編集",
                "subtitle": "一覧からカードを選ぶと入力欄が埋まります"
              },
              {
                "type": "form",
                "id": "record_edit_form",
                "submit_label": "更新",
                "submit_action": {
                  "type": "composite",
                  "actions": [
                    {
                      "type": "update_record",
                      "target_state_ref": "records",
                      "record_id_ref": "selected",
                      "field_bindings": {
                        "photo": "edit_field_photo",
                        "date": "edit_field_date",
                        "note": "edit_field_note"
                      }
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_photo"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_date"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_note"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "selected"
                    }
                  ]
                },
                "children": [
                  {
                    "type": "text_field",
                    "id": "edit_field_photo_edit_input",
                    "state_ref": "edit_field_photo",
                    "placeholder": "写真",
                    "validation": {
                      "rules": [
                        {
                          "type": "required",
                          "message": "写真を入力してください"
                        }
                      ]
                    }
                  },
                  {
                    "type": "date_field",
                    "id": "edit_field_date_edit_input",
                    "state_ref": "edit_field_date",
                    "label": "日付"
                  },
                  {
                    "type": "text_field",
                    "id": "edit_field_note_edit_input",
                    "state_ref": "edit_field_note",
                    "placeholder": "メモ"
                  }
                ]
              },
              {
                "type": "button",
                "id": "record_delete_button",
                "style_role": "button.secondary",
                "label": "削除",
                "action": {
                  "type": "composite",
                  "actions": [
                    {
                      "type": "delete_record",
                      "target_state_ref": "records",
                      "record_id_ref": "selected"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_photo"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_date"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "edit_field_note"
                    },
                    {
                      "type": "reset_state",
                      "state_ref": "selected"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "app": {
    "title": "写真記録"
  },
  "record_schemas": {
    "record": {
      "fields": [
        {
          "name": "photo",
          "type": "string",
          "label": "写真",
          "required": true
        },
        {
          "name": "date",
          "type": "date",
          "label": "日付",
          "required": false
        },
        {
          "name": "note",
          "type": "string",
          "label": "メモ",
          "required": false
        }
      ]
    }
  },
  "design_tokens": {
    "color_scheme": {
      "primary": "#5B7C99",
      "secondary": "#8FA8BD",
      "success": "#6B9080",
      "error": "#C1666B"
    },
    "corner_radius": {
      "small": 8,
      "medium": 12,
      "large": 16
    },
    "spacing_scale": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32
    }
  }
}
