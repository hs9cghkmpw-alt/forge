{
  "version": "1.5",
  "initial_screen_id": "generated_screen",
  "screens": [
    {
      "id": "generated_screen",
      "title": "旅行の写真を日付ごとに残してメモを付けたい",
      "state": {
        "items": {
          "type": "checklist",
          "value": [
            {
              "id": "item_1",
              "text": "充電器",
              "done": false
            },
            {
              "id": "item_2",
              "text": "着替え",
              "done": false
            },
            {
              "id": "item_3",
              "text": "歯ブラシ",
              "done": false
            }
          ]
        },
        "new_item_text": {
          "type": "string",
          "value": ""
        }
      },
      "body": {
        "type": "column",
        "id": "root_column",
        "children": [
          {
            "type": "checklist",
            "id": "list_view",
            "state_ref": "items",
            "empty_state_text": "まだ何もありません"
          },
          {
