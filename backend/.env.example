# Forge Backend 環境変数の例。
#
# 使い方: このファイルをコピーして `.env` という名前で保存し、値を埋めて
# ください。`.env`(および`.env.local`等)は`.gitignore`で除外済みです。
#
# ---
#
# **このファイルには値を書きません**(FORGE-AI-FOUNDATION-010 §14〜§18)。
# Git追跡対象に置いてよいのは**環境変数の名前だけ**であり、API Keyの実値・
# その断片・長さ等は、ソース・テスト・ドキュメント・レポートのいずれにも
# 書きません。`backend/tests/test_provider_registry.py`がこれを検査します。
#
# ---
#
# ## Providerは環境変数で自動的に増えます(Phase F)
#
# Forgeは起動時に、下の変数のうち**実際に設定されているもの**だけを
# AI Routingの候補に載せます(`app/ai/gateway/provider_registry.py`)。
# 鍵を設定していないCloud Providerは候補に入りません——必ず認証エラーに
# なる相手を試して、待ち時間を増やすだけだからです。
#
# 「実装があること」と「設定があること」は別に判定されます。実装が
# スタブのProvider(openai/claude)は、鍵を設定しても候補になりません。


# ---------------------------------------------------------------------------
# AI Provider(いずれか1つ以上を設定してください)
# ---------------------------------------------------------------------------

# Google Gemini(無料枠あり)。**現時点で唯一、品質を実測済みのProvider**。
# 取得: https://aistudio.google.com/apikey の「Get API key」
# (Googleアカウントが必要)。
GEMINI_API_KEY=

# OpenAI。**現時点ではAdapterが未実装**(呼ぶとNotImplementedError)。
# 設定しても候補になりません。実装後に有効になります。
OPENAI_API_KEY=

# Anthropic Claude。同上、Adapter未実装。
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# OpenAI互換のCloud Provider（何個でも同時に設定できます）
# ---------------------------------------------------------------------------
#
# 「Geminiの無料枠が尽きてもForgeが止まらない」ための枠です。
# OpenAI互換の `/v1/chat/completions` を提供するCloud Providerなら、
# 3つの変数を設定するだけでAI Routingへ載ります（**コード変更は不要**）。
#
# **Providerごとに別々の枠です**（FORGE-AI-FOUNDATION-011 §1）。
# 以前は `FORGE_CLOUD_*` という汎用枠が1つだけで、中身を差し替えると
# 昨日のGroqと今日のCerebrasが同じ統計へ混ざる構造でした。今は
# `provider_id` ごとに Quota・Circuit Breaker・Benchmark が分かれます。
#
# 3つすべてが揃って初めて候補になります。どれか欠けていると、
# 「どこへ何を投げればよいか」が決まらないためです。
#
# エンドポイントとモデル名は、必ず**利用するProviderの公式ドキュメント**で
# 確認してください。ここに特定Providerの値を書いていないのは、この開発環境
# からProvider公式ドキュメントへアクセスできず、検証できなかったためです
# （未検証の値を「実装済み」として書かない方針）。

# --- Groq -------------------------------------------------------------
FORGE_GROQ_BASE_URL=
FORGE_GROQ_API_KEY=
FORGE_GROQ_MODEL=
# 任意。応答待ちの上限（秒）。既定: 60
FORGE_GROQ_TIMEOUT_SECONDS=
# 任意。追加HTTPヘッダ（JSONオブジェクト）。
FORGE_GROQ_EXTRA_HEADERS=

# --- Cerebras ---------------------------------------------------------
FORGE_CEREBRAS_BASE_URL=
FORGE_CEREBRAS_API_KEY=
FORGE_CEREBRAS_MODEL=
FORGE_CEREBRAS_TIMEOUT_SECONDS=
FORGE_CEREBRAS_EXTRA_HEADERS=

# --- OpenRouter -------------------------------------------------------
# OpenRouterは `HTTP-Referer` / `X-Title` ヘッダを推奨しています。
# 例: {"HTTP-Referer": "https://example.com", "X-Title": "Forge"}
FORGE_OPENROUTER_BASE_URL=
FORGE_OPENROUTER_API_KEY=
FORGE_OPENROUTER_MODEL=
FORGE_OPENROUTER_TIMEOUT_SECONDS=
FORGE_OPENROUTER_EXTRA_HEADERS=

# --- Together ---------------------------------------------------------
FORGE_TOGETHER_BASE_URL=
FORGE_TOGETHER_API_KEY=
FORGE_TOGETHER_MODEL=
FORGE_TOGETHER_TIMEOUT_SECONDS=
FORGE_TOGETHER_EXTRA_HEADERS=

# --- DeepInfra --------------------------------------------------------
FORGE_DEEPINFRA_BASE_URL=
FORGE_DEEPINFRA_API_KEY=
FORGE_DEEPINFRA_MODEL=
FORGE_DEEPINFRA_TIMEOUT_SECONDS=
FORGE_DEEPINFRA_EXTRA_HEADERS=


# ---------------------------------------------------------------------------
# 上の一覧に無いProviderを足す（コード変更なし）
# ---------------------------------------------------------------------------
#
# 名前をカンマ区切りで並べると、その名前で枠が増えます。
# 環境変数の規約は上と同じ `FORGE_<大文字の名前>_BASE_URL` 等です。
#
#   FORGE_EXTRA_PROVIDERS=myhost,another
#   FORGE_MYHOST_BASE_URL=...
#   FORGE_MYHOST_API_KEY=...
#   FORGE_MYHOST_MODEL=...
#
# 既存Provider名（gemini/local/mock/groq等）は上書きできません。
FORGE_EXTRA_PROVIDERS=


# ---------------------------------------------------------------------------
# ローカル推論Runtime(鍵不要)
# ---------------------------------------------------------------------------
#
# Ollama等のOpenAI互換Runtimeへ接続します。**起動しているかどうかは
# 環境変数から判定できない**ため、Forgeは常に候補に載せ、繋がらなければ
# その場で学習して次の候補へ回します。

# 既定: http://127.0.0.1:11434/v1
FORGE_LOCAL_BASE_URL=

# 既定: qwen2.5:3b-instruct
FORGE_LOCAL_MODEL=

# 応答待ちの上限(秒)。既定: 120
FORGE_LOCAL_TIMEOUT_SECONDS=


# ---------------------------------------------------------------------------
# 運用上の固定(任意)
# ---------------------------------------------------------------------------

# 設定すると、Routingを行わず**この1つだけ**を使います。運用者の明示指定を
# Routerが上書きしないための逃げ道です。未登録の名前を書くと起動時に
# 失敗します(黙って別のProviderへ倒れません)。
#
# `mock` を指定した場合、応答は模擬であり、APIレスポンスは必ず
# `simulated: true` を返します。
#
# 例: gemini / local / mock
FORGE_DEFAULT_PROVIDER=

# development(既定)/ production。development時はlocalhost/127.0.0.1の
# 任意ポートからのアクセスをCORSで自動的に許可します
# (backend/app/main.py参照)。
FORGE_ENV=development
