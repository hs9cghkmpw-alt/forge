# Forge Backend 環境変数の例。
#
# 実際に使う場合は、このファイルをコピーして `.env` という名前で保存し、
# 値を埋めてください。`.env` はGitにコミットしないでください
# (`.gitignore`で除外する運用を推奨します)。
#
# 現時点(2026-08-10)で、実際にコードから読まれる環境変数はこれだけです。
# 他の変数(Supabase等)は README.md 3章「環境変数」に記載のとおり、
# 今後追加予定です。

# Google Gemini API キー(無料枠あり)。
# 取得方法: https://aistudio.google.com/apikey にアクセスし、
# 「Get API key」から取得してください(Googleアカウントが必要)。
#
# このキーを設定しなくても他の機能(Mock Modeでの生成等)は使えます。
# 設定すると、AI生成リクエストで `generation_options.provider: "gemini"`
# を指定した場合のみ、実際にGemini APIが呼ばれます(既定はmockのまま)。
GEMINI_API_KEY=

# development(既定)/production。development時はlocalhost/127.0.0.1の
# 任意ポートからのアクセスをCORSで自動的に許可します
# (backend/app/main.py参照)。
FORGE_ENV=development
